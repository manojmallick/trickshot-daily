{
  "name": "trickshot-daily",
  "version": "0.1.0",
  "private": true,
  "description": "A browser physics puzzle prototype with deterministic daily levels, obstacles, and shareable results.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "sigmap",
    "map:refresh": "sigmap",
    "map:report": "sigmap --report --json",
    "map:watch": "sigmap daemon start",
    "map:setup": "sigmap --setup"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^2.0.0",
    "@vercel/config": "^0.5.5",
    "sigmap": "^8.18.0"
  }
}
